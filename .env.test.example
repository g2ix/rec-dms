# Copy to .env.test. Loaded by Vitest and not committed.
# Use a database whose name ends in _test, or schema recdms_test.
# The runner truncates that schema between test files and refuses public
# on the shared Supabase database.
#
# CI writes .env.test from the workflow env (Postgres and Mailpit services, s3rver on :9000).
# When S3_* is unset, the storage test starts an in-process S3 server (s3rver). For a local
# S3 without MinIO: node scripts/s3-local.mjs, then S3_ENDPOINT="http://127.0.0.1:9000" and
# S3_ACCESS_KEY / S3_SECRET_KEY "S3RVER".

DATABASE_URL="postgresql://recdms:recdms@127.0.0.1:5432/recdms_test"
DIRECT_URL="postgresql://recdms:recdms@127.0.0.1:5432/recdms_test"
AUTH_SECRET="test-secret"
AUTH_URL="http://127.0.0.1:3000"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="recdms-files"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
S3_REGION="us-east-1"
SMTP_URL="smtp://127.0.0.1:1025"
EMAIL_FROM="REC-DMS <noreply@localhost>"
APP_TIMEZONE="Asia/Manila"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
BOOTSTRAP_ADMIN_EMAILS="admin@usc.edu.ph"
