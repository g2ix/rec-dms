# Copy to .env.local and fill the password and S3 keys.
# Local development uses the Supabase project rec-dms (jrgsxhcegqstegpqgbyv).
# App tables live in schema recdms. Do not point Prisma at public:
# that schema already holds another application's tables.
#
# Copy the pooler host from the Supabase connect panel. The aws-0 / aws-1
# prefix depends on the project. Use the session pooler (port 5432) for
# DIRECT_URL so this machine does not need IPv6.
#
# Create an S3 access key under Storage → S3 Configuration. It is shown once.
# The private bucket recdms-files already exists.

DATABASE_URL="postgresql://postgres.jrgsxhcegqstegpqgbyv:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=recdms&sslmode=require"
DIRECT_URL="postgresql://postgres.jrgsxhcegqstegpqgbyv:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=recdms&sslmode=require"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

S3_ENDPOINT="https://jrgsxhcegqstegpqgbyv.storage.supabase.co/storage/v1/s3"
S3_BUCKET="recdms-files"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-southeast-1"

# Left empty until M10. PDF_CONVERTER=gotenberg|soffice chooses the converter then.
GOTENBERG_URL=""
GOTENBERG_SECRET=""

# Mailpit standalone binary: pnpm mailpit
# SMTP smtp://127.0.0.1:1025  UI http://127.0.0.1:8025
SMTP_URL="smtp://127.0.0.1:1025"
EMAIL_FROM="USC REC-DMS <noreply@localhost>"
APP_TIMEZONE="Asia/Manila"
