{
  "name": "rec-dms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "node --experimental-strip-types scripts/tokens-check.ts && eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-env.mjs node --experimental-transform-types --import ./scripts/register-ts.mjs prisma/seed.ts",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "mailpit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mailpit.ps1",
    "cron": "node scripts/cron-dev.mjs",
    "audit:verify": "node scripts/with-env.mjs node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/audit-verify.ts",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@hookform/resolvers": "^7.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@xyflow/react": "^12.12.1",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "json-logic-js": "^2.0.5",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "signature_pad": "^5.1.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "eslint-plugin-tailwindcss": "4.4.0",
    "prisma": "6.19.3",
    "s3rver": "^3.7.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
