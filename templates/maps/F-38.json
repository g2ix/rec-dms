{
  "protocol.code": {
    "helper": "text",
    "path": "protocol.code"
  },
  "protocol.title": {
    "helper": "text",
    "path": "protocol.title"
  },
  "protocol.versionLabel": {
    "helper": "text",
    "path": "protocol.versionLabel"
  },
  "protocol.researchers": {
    "helper": "join",
    "path": "protocol.researchers"
  },
  "signedFooter": {
    "helper": "signedFooter"
  },
  "praf": {
    "helper": "assessmentRows",
    "path": "praf",
    "columns": [
      "code",
      "label",
      "page",
      "panel_comments",
      "actions_taken",
      "panel_remarks"
    ],
    "onlyFilled": [
      "needs_action"
    ]
  },
  "icf": {
    "helper": "assessmentRows",
    "path": "icf",
    "columns": [
      "code",
      "label",
      "page",
      "panel_comments",
      "actions_taken",
      "panel_remarks"
    ],
    "onlyFilled": [
      "needs_action"
    ]
  },
  "cb_action_APPROVED": {
    "helper": "checkbox",
    "path": "recommended_action",
    "equals": "APPROVED",
    "covers": [
      "recommended_action"
    ]
  },
  "cb_action_MINOR": {
    "helper": "checkbox",
    "path": "recommended_action",
    "equals": "MINOR"
  },
  "cb_action_MAJOR": {
    "helper": "checkbox",
    "path": "recommended_action",
    "equals": "MAJOR"
  },
  "cb_action_DISAPPROVED": {
    "helper": "checkbox",
    "path": "recommended_action",
    "equals": "DISAPPROVED"
  },
  "justification": {
    "helper": "text",
    "path": "justification"
  },
  "sig_researcher": {
    "helper": "signature",
    "path": "researcher_signature",
    "width": 160,
    "height": 48
  },
  "sig_adviser": {
    "helper": "signature",
    "path": "adviser_signature",
    "width": 160,
    "height": 48
  }
}
