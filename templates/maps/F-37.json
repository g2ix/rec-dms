  },
  "icf": {
    "helper": "assessmentRows",
    "path": "icf",
    "columns": [
      "code",
      "label",
      "comments",
      "recommendations"
    ],
    "onlyFilled": [
      "comments",
      "recommendations"
    ]
  },
