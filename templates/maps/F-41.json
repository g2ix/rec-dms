      "recommended_action"
    ]
  },
  "cb_action_NOT_QUALIFIED": {
    "helper": "checkbox",
    "path": "recommended_action",
    "equals": "NOT_QUALIFIED"
  },
  "summary": {
    "helper": "text",
    "path": "summary"
  },
  "justification": {
    "helper": "text",
    "path": "justification"
  },
  "sig_chair": {
    "helper": "signature",
    "path": "chair_signature",
    "width": 160,
    "height": 48
  }
}
