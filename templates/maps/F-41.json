{
  "protocol.code": {
    "helper": "text",
    "path": "protocol.code"
  },
  "protocol.title": {
    "helper": "text",
    "path": "protocol.title"
  },
  "protocol.versionLabel": {
    "helper": "text",
    "path": "protocol.versionLabel"
  },
  "protocol.researchers": {
    "helper": "join",
    "path": "protocol.researchers"
  },
  "signedFooter": {
    "helper": "signedFooter"
  },
  "criteria": {
    "helper": "assessmentRows",
    "path": "criteria",
    "columns": [
      "code",
      "label",
      "answer",
      "comments"
    ]
  },
  "cb_action_QUALIFIED": {
    "helper": "checkbox",
    "path": "recommended_action",
    "equals": "QUALIFIED",
