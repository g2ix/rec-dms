    ]
  },
  "cb_submission_RESUBMISSION": {
    "helper": "checkbox",
    "path": "submission_type",
    "equals": "RESUBMISSION"
  },
  "cb_decision_APPROVED": {
    "helper": "checkbox",
    "path": "decision",
