generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Application settings. REC process values are seeded in a later milestone.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  MERGED
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  LINK_EMAIL
  STEP_UP
}

enum RoleScope {
  GLOBAL
  PANEL
  PROTOCOL
}

enum ProtocolMemberRole {
  PROPONENT
  ADVISER
  REVIEWER
  PRIMARY_REVIEWER
  INDEPENDENT_CONSULTANT
}

enum AffiliationKind {
  STUDENT
  FACULTY
}

enum OrgUnitKind {
  SCHOOL
  DEPARTMENT
  OFFICE
  PROGRAM
}

enum AcademicLevel {
  UNDERGRADUATE
  GRADUATE
}

enum ReviewType {
  EXEMPT
  EXPEDITED
  FULL
}

enum ProtocolVersionState {
  WORKING
  SUBMITTED
}

enum FileKind {
  MANUSCRIPT
  COVER_LETTER
  FEE_RECEIPT
  SUPPORTING
  GENERATED_DOCX
  GENERATED_PDF
  SIGNATURE_IMAGE
  TEMPLATE
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

enum FeeStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// One person. Merged rows stay so the audit chain can still point at them.
model User {
  id             String     @id @default(uuid())
  firstName      String     @map("first_name")
  middleName     String?    @map("middle_name")
  middleInitial  String?    @map("middle_initial")
  familyName     String     @map("family_name")
  title          String?
  suffix         String?
  credentials    String[]   @default([])
  displayName    String     @map("display_name")
  name           String?
  email          String?    @unique
  emailVerified  DateTime?  @map("email_verified")
  image          String?
  status         UserStatus @default(PENDING_APPROVAL)
  passwordHash   String?    @map("password_hash")
  primaryEmailId String?    @unique @map("primary_email_id")
  approvedById   String?    @map("approved_by_id")
  approvedAt     DateTime?  @map("approved_at")
  mergedIntoId   String?    @map("merged_into_id")
  totpSecret     String?    @map("totp_secret")
  totpEnabledAt  DateTime?  @map("totp_enabled_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  primaryEmail           UserEmail?              @relation("PrimaryEmail", fields: [primaryEmailId], references: [id], onDelete: SetNull)
  emails                 UserEmail[]             @relation("UserEmails")
  accounts               Account[]
  sessions               Session[]
  approvedBy             User?                   @relation("Approvals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers          User[]                  @relation("Approvals")
  mergedInto             User?                   @relation("Merges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom             User[]                  @relation("Merges")
  emailCodes             EmailCode[]
  roles                  UserRole[]
  memberships            ProtocolMember[]
  signatures             Signature[]
  signatureEvents        SignatureEvent[]
  signingStepUps         SigningStepUp[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  tasks                  Task[]                  @relation("TaskAssignee")
  tasksCompleted         Task[]                  @relation("TaskCompleter")
  workflowsPublished     WorkflowVersion[]       @relation("WorkflowPublisher")
  protocolsCreated       Protocol[]              @relation("ProtocolCreator")
  mergeSessionsPrimary   MergeSession[]          @relation("MergePrimary")
  mergeSessionsSecondary MergeSession[]          @relation("MergeSecondary")
  mergeSessionsCreated   MergeSession[]          @relation("MergeCreator")
  auditEvents            AuditEvent[]
  formDefinitions        FormDefinition[]
  formFieldRevisions     FormFieldRevision[]
  protocolsLed           Protocol[]              @relation("ProtocolLeader")
  versionsSubmitted      ProtocolVersion[]       @relation("VersionSubmitter")
  filesUploaded          StoredFile[]
  feeDecisions           FeeVerification[]       @relation("FeeVerifier")
  presence               Presence[]
  uploadIntents          UploadIntent[]
  invitationsSent        ProtocolMember[]        @relation("MemberInviter")
  profile                PersonProfile?
  directoryEntry         DirectoryEntry?

  @@index([status])
  @@index([mergedIntoId])
  @@map("users")
}

model UserEmail {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  email       String    @unique
  verifiedAt  DateTime? @map("verified_at")
  isContact   Boolean   @default(false) @map("is_contact")
  isPrimary   Boolean   @default(false) @map("is_primary")
  defaultView String?   @map("default_view")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User             @relation("UserEmails", fields: [userId], references: [id], onDelete: Cascade)
  primaryFor  User?            @relation("PrimaryEmail")
  memberships ProtocolMember[]

  @@index([userId])
  @@map("user_emails")
}

model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  defaultView       String?  @map("default_view")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model EmailCode {
  id         String           @id @default(uuid())
  email      String
  purpose    EmailCodePurpose
  codeHash   String           @map("code_hash")
  expiresAt  DateTime         @map("expires_at")
  attempts   Int              @default(0)
  userId     String?          @map("user_id")
  payload    Json?
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@map("email_codes")
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("rate_limits")
}

model MergeSession {
  id                String    @id @default(uuid())
  primaryUserId     String    @map("primary_user_id")
  secondaryUserId   String    @map("secondary_user_id")
  primaryStepUpAt   DateTime? @map("primary_step_up_at")
  secondaryStepUpAt DateTime? @map("secondary_step_up_at")
  createdById       String    @map("created_by_id")
  mode              String
  expiresAt         DateTime  @map("expires_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  primaryUser   User @relation("MergePrimary", fields: [primaryUserId], references: [id])
  secondaryUser User @relation("MergeSecondary", fields: [secondaryUserId], references: [id])
  createdBy     User @relation("MergeCreator", fields: [createdById], references: [id])

  @@index([primaryUserId])
  @@map("merge_sessions")
}

/// Introduced for account merge. M02 adds permissions and the admin UI on these rows.
model Role {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  scope       RoleScope
  description String    @default("")
  isSystem    Boolean   @default(true) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  grants UserRole[]

  @@map("roles")
}

model UserRole {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  panelId     String?   @map("panel_id")
  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  /// Member attributes on a panel grant: designation, isScientist, discipline, affiliate, alternate.
  attributes  Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

/// A review panel. Disciplines point at the panel they suggest.
model Panel {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  disciplines Discipline[]
  protocols   Protocol[]

  @@map("panels")
}

model Discipline {
  id        String   @id @default(uuid())
  name      String   @unique
  panelId   String   @map("panel_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  panel     Panel      @relation(fields: [panelId], references: [id])
  protocols Protocol[]

  @@index([panelId])
  @@map("disciplines")
}

/// REC application research types. Others asks for a specification.
model ResearchType {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  sortOrder Int      @map("sort_order")
  specify   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("research_types")
}

/// REC application funding sources. Some ask for an institution, agency, or other name.
model FundingSourceKind {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  sortOrder Int      @map("sort_order")
  detail    String   @default("NONE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("funding_source_kinds")
}

model Protocol {
  id                       String      @id @default(uuid())
  code                     String?     @unique
  title                    String
  disciplineId             String?     @map("discipline_id")
  panelId                  String?     @map("panel_id")
  reviewType               ReviewType? @map("review_type")
  status                   String      @default("DRAFT")
  leaderUserId             String      @map("leader_user_id")
  institution              String      @default("")
  institutionAddress       String      @default("") @map("institution_address")
  researchType             String      @default("") @map("research_type")
  researchTypeCodes        String[]    @default([]) @map("research_type_codes")
  researchTypeOther        String      @default("") @map("research_type_other")
  durationMonths           Int?        @map("duration_months")
  expectedParticipants     Int?        @map("expected_participants")
  studySite                String      @default("") @map("study_site")
  fundingSources           Json        @default("[]") @map("funding_sources")
  retentionFlaggedAt       DateTime?   @map("retention_flagged_at")
  /// Fee client type, suggested from the project leader profile and set by REC Staff.
  clientTypeKey            String?     @map("client_type_key")
  /// An admin may move this protocol to another workflow version only while this is on.
  workflowMigrationEnabled Boolean     @default(false) @map("workflow_migration_enabled")
  createdById              String      @map("created_by_id")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  createdBy         User               @relation("ProtocolCreator", fields: [createdById], references: [id])
  leader            User               @relation("ProtocolLeader", fields: [leaderUserId], references: [id])
  discipline        Discipline?        @relation(fields: [disciplineId], references: [id])
  panel             Panel?             @relation(fields: [panelId], references: [id])
  members           ProtocolMember[]
  versions          ProtocolVersion[]
  workflowInstances WorkflowInstance[]
  notifications     Notification[]
  bills             Bill[]

  @@index([status])
  @@index([leaderUserId])
  @@index([disciplineId])
  @@index([panelId])
  @@index([panelId, status, reviewType])
  @@map("protocols")
}

model ProtocolMember {
  id              String             @id @default(uuid())
  protocolId      String             @map("protocol_id")
  userId          String?            @map("user_id")
  role            ProtocolMemberRole
  isLeader        Boolean            @default(false) @map("is_leader")
  rosterOrder     Int                @default(1) @map("roster_order")
  status          String             @default("ACTIVE")
  contactEmailId  String?            @map("contact_email_id")
  affiliationKind AffiliationKind?   @map("affiliation_kind")
  course          String?
  yearLabel       String?            @map("year_label")
  position        String?
  unit            String?
  institution     String             @default("")
  designation     String             @default("")
  profileKind     String?            @map("profile_kind")
  academicLevel   AcademicLevel?     @map("academic_level")
  schoolName      String?            @map("school_name")
  departmentName  String?            @map("department_name")
  officeName      String?            @map("office_name")
  programName     String?            @map("program_name")
  contactNumber   String?            @map("contact_number")
  invitedEmail    String?            @map("invited_email")
  invitedById     String?            @map("invited_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  protocol      Protocol       @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])
  contactEmail  UserEmail?     @relation(fields: [contactEmailId], references: [id])
  invitedBy     User?          @relation("MemberInviter", fields: [invitedById], references: [id])
  formInstances FormInstance[]
  agreements    IntakeAgreement[]

  @@unique([protocolId, userId])
  @@index([userId])
  @@index([userId, role, status])
  @@index([invitedEmail])
  @@index([protocolId, status])
  @@map("protocol_members")
}

model ProtocolVersion {
  id             String               @id @default(uuid())
  protocolId     String               @map("protocol_id")
  number         Int
  label          String
  state          ProtocolVersionState @default(WORKING)
  submittedAt    DateTime?            @map("submitted_at")
  submittedById  String?              @map("submitted_by_id")
  snapshot       Json                 @default("{}")
  /// Set while a frozen version is reopened for correction. Holds the data to diff on re-freeze.
  reopenBaseline Json?                @map("reopen_baseline")
  reopenedAt     DateTime?            @map("reopened_at")
  reopenForms    String[]             @default([]) @map("reopen_forms")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  protocol          Protocol           @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  submittedBy       User?              @relation("VersionSubmitter", fields: [submittedById], references: [id])
  files             StoredFile[]
  fee               FeeVerification?
  signatureEvents   SignatureEvent[]
  workflowInstances WorkflowInstance[]
  intake            ProtocolIntake?
  revisionNotes     RevisionNote[]

  @@unique([protocolId, number])
  @@index([protocolId, state])
  @@index([submittedAt])
  @@map("protocol_versions")
}

/// INTAKE-04: a comment the adviser, REC Staff or the Panel Chair pins to one intake section or
/// upload when returning a protocol. A draft (taskId null) is the author's own until the return
/// goes out; the proponents then tick it Done and may reply. Reviewer comments never come here.
model RevisionNote {
  id                String    @id @default(uuid())
  protocolVersionId String    @map("protocol_version_id")
  authorId          String    @map("author_id")
  /// ADVISER, REC_STAFF or PANEL (shown to the proponents as "Adviser", "REC Staff" or "Panel").
  authorRole        String    @map("author_role")
  /// An Intake rail section ("study", "coi", …), "upload:<FILE KIND>", or "general".
  anchor            String
  body              String
  /// The return task it went out with. Null while it is a draft.
  taskId            String?   @map("task_id")
  sentAt            DateTime? @map("sent_at")
  doneAt            DateTime? @map("done_at")
  doneById          String?   @map("done_by_id")
  reply             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  protocolVersion ProtocolVersion @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)

  @@index([protocolVersionId, taskId])
  @@map("revision_notes")
}

/// Object-storage pointer. Named StoredFile so it does not clash with the DOM File type.
/// What the proponents answer once per protocol version. F-27, F-28, F-30 and the proponent
/// columns of F-35, F-36 and F-38 are printed from it and from the protocol's study details.
model ProtocolIntake {
  id                String   @id @default(uuid())
  protocolVersionId String   @unique @map("protocol_version_id")
  /// { consentNeeded, waiverReason, minors, vulnerable, focusGroups, onlineConsent, nonEnglishIcf, facultyInitiated, personalData }
  scoping           Json     @default("{}")
  /// { kind: "NONE" | "SPECIFY", text }
  coi               Json     @default("{}")
  /// [{ id, section: PS | MOOE | CAPITAL | ADMIN, item, personal, external, internal }] in centavos
  budgetLines       Json     @default("[]") @map("budget_lines")
  /// { [point code]: { page, line } | "NA" }
  references        Json     @default("{}")
  /// F-38 on a resubmission: { [point code]: actions taken, with page and paragraph }
  actions           Json     @default("{}")
  revision          Int      @default(0)
  /// Who saved each section last, at which revision: { [section]: { revision, userId, at } }. Used for conflicts.
  sectionRevisions  Json     @default("{}") @map("section_revisions")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  protocolVersion ProtocolVersion   @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)
  agreements      IntakeAgreement[]

  @@map("protocol_intakes")
}

enum IntakeAgreementKind {
  DECLARATIONS
  F28_CONSENT
}

/// One researcher's agreement to the F-27 declarations or the F-28 consents. The signature itself
/// stays in signature_events; this row only points at it.
model IntakeAgreement {
  id               String              @id @default(uuid())
  intakeId         String              @map("intake_id")
  memberId         String              @map("member_id")
  kind             IntakeAgreementKind
  agreedAt         DateTime            @map("agreed_at")
  signatureEventId String?             @map("signature_event_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  intake         ProtocolIntake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  member         ProtocolMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  signatureEvent SignatureEvent? @relation(fields: [signatureEventId], references: [id])

  @@unique([intakeId, memberId, kind])
  @@index([signatureEventId])
  @@map("intake_agreements")
}

model StoredFile {
  id                String     @id @default(uuid())
  protocolVersionId String?    @map("protocol_version_id")
  kind              FileKind
  originalName      String     @map("original_name")
  suggestedName     String?    @map("suggested_name")
  storageKey        String     @unique @map("storage_key")
  mime              String
  size              Int
  sha256            String
  uploadedById      String     @map("uploaded_by_id")
  scanStatus        ScanStatus @default(PENDING) @map("scan_status")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  /// Set when this file was generated from a form instance, so a reprint of the same revision can be reused.
  formInstanceId String? @map("form_instance_id")
  sourceRevision Int?    @map("source_revision")
  /// Proof of payment against this bill.
  billId         String? @map("bill_id")
  /// STAFF hides a generated file from proponents and advisers. Null keeps the earlier rules.
  audience       String?
  /// A render variant of the same revision, such as a redacted release copy.
  variant        String?
  /// INTAKE-04: the file of the previous version this upload was carried over from (a copy of its bytes).
  carriedFromId  String? @map("carried_from_id")

  protocolVersion ProtocolVersion? @relation(fields: [protocolVersionId], references: [id])
  formInstance    FormInstance?    @relation(fields: [formInstanceId], references: [id], onDelete: SetNull)
  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  signatures      Signature[]

  @@index([protocolVersionId, kind])
  @@index([formInstanceId, kind, sourceRevision])
  @@index([billId])
  @@map("files")
}

model FeeVerification {
  id                String    @id @default(uuid())
  protocolVersionId String    @unique @map("protocol_version_id")
  status            FeeStatus @default(PENDING)
  reason            String?
  verifiedById      String?   @map("verified_by_id")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  protocolVersion ProtocolVersion @relation(fields: [protocolVersionId], references: [id], onDelete: Cascade)
  verifiedBy      User?           @relation("FeeVerifier", fields: [verifiedById], references: [id])

  @@index([status])
  @@map("fee_verifications")
}

/// Who is viewing a form. Polled; replace the store later without changing the page.
model Presence {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  formInstanceId String   @map("form_instance_id")
  seenAt         DateTime @map("seen_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, formInstanceId])
  @@index([formInstanceId, seenAt])
  @@map("presence")
}

model UploadIntent {
  id                String   @id @default(uuid())
  protocolVersionId String   @map("protocol_version_id")
  kind              FileKind
  storageKey        String   @unique @map("storage_key")
  originalName      String   @map("original_name")
  suggestedName     String?  @map("suggested_name")
  mime              String
  uploadedById      String   @map("uploaded_by_id")
  /// Proof of payment for this bill. It may arrive while the version is frozen.
  billId            String?  @map("bill_id")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([expiresAt])
  @@map("upload_intents")
}

enum SignatureCapture {
  DRAWN
  UPLOADED
}

enum SignatureEventMethod {
  IMAGE
}

/// Versioned signature image. One active row per user. Past versions stay for events that used them.
model Signature {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  version   Int              @default(1)
  imageKey  String           @map("image_key")
  fileId    String?          @unique @map("file_id")
  method    SignatureCapture @default(UPLOADED)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  file   StoredFile?      @relation(fields: [fileId], references: [id])
  events SignatureEvent[]

  @@index([userId])
  @@map("signatures")
}

/// A successful identity confirmation. Valid for signing only, and only until expiresAt.
model SigningStepUp {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  confirmedAt DateTime @map("confirmed_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("signing_step_ups")
}

/// One act of signing one field. method stays IMAGE until certificate signatures exist.
model SignatureEvent {
  id                String               @id @default(uuid())
  formInstanceId    String               @map("form_instance_id")
  fieldPath         String               @map("field_path")
  userId            String               @map("user_id")
  signatureId       String               @map("signature_id")
  dataHash          String               @map("data_hash")
  protocolVersionId String?              @map("protocol_version_id")
  signedAt          DateTime             @map("signed_at")
  ip                String?
  userAgent         String?              @map("user_agent")
  voidedAt          DateTime?            @map("voided_at")
  voidReason        String?              @map("void_reason")
  verifyRef         String               @unique @map("verify_ref")
  method            SignatureEventMethod @default(IMAGE)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  formInstance    FormInstance     @relation(fields: [formInstanceId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  signature       Signature        @relation(fields: [signatureId], references: [id])
  protocolVersion ProtocolVersion? @relation(fields: [protocolVersionId], references: [id])
  agreements      IntakeAgreement[]

  @@index([formInstanceId])
  @@index([userId])
  @@index([protocolVersionId])
  @@map("signature_events")
}

enum NotificationEmailStatus {
  NONE
  QUEUED
  SENT
  FAILED
  DIGEST
}

enum DigestMode {
  IMMEDIATE
  DAILY
}

model Notification {
  id          String                  @id @default(uuid())
  userId      String                  @map("user_id")
  type        String
  title       String                  @default("")
  body        String                  @default("")
  link        String?
  protocolId  String?                 @map("protocol_id")
  taskId      String?                 @map("task_id")
  payload     Json                    @default("{}")
  readAt      DateTime?               @map("read_at")
  emailedAt   DateTime?               @map("emailed_at")
  emailStatus NotificationEmailStatus @default(NONE) @map("email_status")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  protocol Protocol? @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([emailStatus])
  @@index([protocolId, createdAt])
  @@map("notifications")
}

/// Editable copy for in-app notices and email. `variables` is the documented placeholder list.
model NotificationTemplate {
  id           String   @id @default(uuid())
  key          String   @unique
  subject      String
  bodyMarkdown String   @map("body_markdown") @db.Text
  channels     String[] @default(["IN_APP", "EMAIL"])
  description  String   @default("")
  variables    Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

/// Daily digest covers reminders. Assignments and decisions stay immediate.
model NotificationPreference {
  userId    String     @id @map("user_id")
  digest    DigestMode @default(IMMEDIATE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// One unit of work on a workflow instance. assignee is empty until a role task is claimed.
model Task {
  id             String    @id @default(uuid())
  instanceId     String?   @map("instance_id")
  stepKey        String?   @map("step_key")
  assigneeUserId String?   @map("assignee_user_id")
  candidateRule  Json?     @map("candidate_rule")
  title          String    @default("")
  status         String    @default("OPEN")
  outcome        String?
  comment        String?
  dueAt          DateTime? @map("due_at")
  remindedAt     Json?     @map("reminded_at")
  escalatedAt    DateTime? @map("escalated_at")
  completedAt    DateTime? @map("completed_at")
  completedById  String?   @map("completed_by_id")
  /// MAIN advances the step. SIDE is a request that stays beside it, such as an extension.
  kind           String    @default("MAIN")
  sideKey        String?   @map("side_key")
  /// Reviewer slot key when the step assigns reviewers by slot.
  slot           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  instance      WorkflowInstance? @relation(fields: [instanceId], references: [id])
  assignee      User?             @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  completedBy   User?             @relation("TaskCompleter", fields: [completedById], references: [id])
  notifications Notification[]

  @@index([assigneeUserId])
  @@index([assigneeUserId, status])
  @@index([instanceId, stepKey])
  @@index([status, dueAt])
  @@index([stepKey, status, createdAt])
  @@map("tasks")
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

/// One submission type. Only one version is published at a time.
model WorkflowDefinition {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  submissionType String   @map("submission_type")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  versions WorkflowVersion[]

  @@map("workflow_definitions")
}

/// The graph is one jsonb document so a version publishes atomically.
model WorkflowVersion {
  id                   String                @id @default(uuid())
  definitionId         String                @map("definition_id")
  number               Int
  status               WorkflowVersionStatus @default(DRAFT)
  graph                Json
  notes                String?
  publishedById        String?               @map("published_by_id")
  publishedAt          DateTime?             @map("published_at")
  /// Scheduled start. Protocols created before this date keep the earlier version.
  effectiveFrom        DateTime?             @map("effective_from")
  effectiveAnnouncedAt DateTime?             @map("effective_announced_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  definition  WorkflowDefinition @relation(fields: [definitionId], references: [id])
  publishedBy User?              @relation("WorkflowPublisher", fields: [publishedById], references: [id])
  instances   WorkflowInstance[]

  @@unique([definitionId, number])
  @@index([definitionId, status])
  @@map("workflow_versions")
}

/// A protocol submission pinned to the version that was published when it started.
model WorkflowInstance {
  id                String                 @id @default(uuid())
  versionId         String                 @map("version_id")
  protocolId        String                 @map("protocol_id")
  protocolVersionId String                 @map("protocol_version_id")
  status            WorkflowInstanceStatus @default(RUNNING)
  currentStepKeys   String[]               @default([]) @map("current_step_keys")
  /// Reviewer user ids chosen at a step, keyed by that step's key.
  assignments       Json                   @default("{}")
  /// Facts captured on a step, keyed by step key, such as noteToReviewers and reviewDueDate.
  captures          Json                   @default("{}")
  startedAt         DateTime               @default(now()) @map("started_at")
  endedAt           DateTime?              @map("ended_at")
  parentInstanceId  String?                @map("parent_instance_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  version         WorkflowVersion    @relation(fields: [versionId], references: [id])
  protocol        Protocol           @relation(fields: [protocolId], references: [id])
  protocolVersion ProtocolVersion    @relation(fields: [protocolVersionId], references: [id])
  parent          WorkflowInstance?  @relation("InstanceChain", fields: [parentInstanceId], references: [id])
  children        WorkflowInstance[] @relation("InstanceChain")
  tasks           Task[]

  @@index([protocolId, status])
  @@index([protocolVersionId])
  @@index([versionId])
  @@index([status])
  @@index([currentStepKeys], type: Gin)
  @@map("workflow_instances")
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("holidays")
}

/// Outbox. M09 delivers these. This milestone only enqueues them.
model Job {
  id        String    @id @default(uuid())
  kind      String
  payload   Json
  runAt     DateTime  @map("run_at")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([doneAt, runAt])
  @@map("jobs")
}

/// Append-only hash chain. M03 adds the admin views; merge writes `user.merged` now.
model AuditEvent {
  id          String   @id @default(uuid())
  seq         BigInt   @unique @default(autoincrement())
  occurredAt  DateTime @map("occurred_at")
  actorUserId String?  @map("actor_user_id")
  actingRole  String?  @map("acting_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  protocolId  String?  @map("protocol_id")
  diff        Json
  meta        Json
  prevHash    String   @map("prev_hash")
  hash        String

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([protocolId])
  @@index([protocolId, occurredAt])
  @@index([actorUserId])
  @@index([occurredAt])
  @@map("audit_events")
}

enum FormDefinitionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum FormInstanceOwnerType {
  PROTOCOL_VERSION
  SANDBOX
}

enum FormInstanceStatus {
  DRAFT
  COMPLETE
  LOCKED
}

/// Versioned form schema. The .docx template is attached in M10.
model FormDefinition {
  id                   String               @id @default(uuid())
  code                 String
  title                String
  version              String
  effectiveDate        DateTime             @map("effective_date") @db.Date
  status               FormDefinitionStatus @default(DRAFT)
  schema               Json
  templateFileId       String?              @map("template_file_id")
  placeholderMap       Json?                @map("placeholder_map")
  createdById          String               @map("created_by_id")
  publishedAt          DateTime?            @map("published_at")
  /// Scheduled start. Protocols created before this date keep the earlier version.
  effectiveFrom        DateTime?            @map("effective_from")
  effectiveAnnouncedAt DateTime?            @map("effective_announced_at")
  /// Not used for protocols created on or after this date. Protocols created earlier keep it, and old copies stay readable.
  retiredFrom          DateTime?            @map("retired_from")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  createdBy User           @relation(fields: [createdById], references: [id])
  instances FormInstance[]

  @@unique([code, version])
  @@index([status])
  @@map("form_definitions")
}

/// One filled copy. Sandbox copies are the admin try-out; protocol copies arrive with submissions.
model FormInstance {
  id               String                @id @default(uuid())
  formDefinitionId String                @map("form_definition_id")
  ownerType        FormInstanceOwnerType @map("owner_type")
  ownerId          String                @map("owner_id")
  filledByMemberId String?               @map("filled_by_member_id")
  data             Json                  @default("{}")
  status           FormInstanceStatus    @default(DRAFT)
  revision         Int                   @default(0)
  /// Sandbox only. The try page stores the simulated role here so a save cannot pick its own role.
  previewRoles     String[]              @default([]) @map("preview_roles")
  previewStep      String?               @map("preview_step")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  formDefinition  FormDefinition      @relation(fields: [formDefinitionId], references: [id])
  filledByMember  ProtocolMember?     @relation(fields: [filledByMemberId], references: [id])
  revisions       FormFieldRevision[]
  signatureEvents SignatureEvent[]
  generatedFiles  StoredFile[]

  @@index([formDefinitionId])
  @@index([ownerType, ownerId])
  @@map("form_instances")
}

/// One row per field save. Feeds the conflict notice and the audit diff.
model FormFieldRevision {
  id             String   @id @default(uuid())
  formInstanceId String   @map("form_instance_id")
  fieldPath      String   @map("field_path")
  value          Json
  userId         String   @map("user_id")
  revision       Int
  at             DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  formInstance FormInstance @relation(fields: [formInstanceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([formInstanceId, fieldPath])
  @@index([formInstanceId, revision])
  @@map("form_field_revisions")
}

/// A university, an outside school, or a company. USC is one row.
model Institution {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String   @default("UNIVERSITY")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units     OrgUnit[]
  profiles  PersonProfile[]
  directory DirectoryEntry[]

  @@map("institutions")
}

/// School, department, office, or program. Programs carry an academic level.
model OrgUnit {
  id            String         @id @default(uuid())
  institutionId String         @map("institution_id")
  parentId      String?        @map("parent_id")
  kind          OrgUnitKind
  name          String
  code          String         @unique
  academicLevel AcademicLevel? @map("academic_level")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  parent      OrgUnit?    @relation("OrgTree", fields: [parentId], references: [id])
  children    OrgUnit[]   @relation("OrgTree")

  profileSchools       PersonProfile[]  @relation("ProfileSchool")
  profileDepartments   PersonProfile[]  @relation("ProfileDepartment")
  profileOffices       PersonProfile[]  @relation("ProfileOffice")
  profilePrograms      PersonProfile[]  @relation("ProfileProgram")
  directorySchools     DirectoryEntry[] @relation("DirectorySchool")
  directoryDepartments DirectoryEntry[] @relation("DirectoryDepartment")
  directoryOffices     DirectoryEntry[] @relation("DirectoryOffice")
  directoryPrograms    DirectoryEntry[] @relation("DirectoryProgram")

  @@index([institutionId])
  @@index([parentId])
  @@map("org_units")
}

/// The person's current affiliation. A protocol membership copies it at the time of joining.
model PersonProfile {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  kind            String
  institutionId   String?        @map("institution_id")
  schoolId        String?        @map("school_id")
  departmentId    String?        @map("department_id")
  officeId        String?        @map("office_id")
  programId       String?        @map("program_id")
  institutionText String         @default("") @map("institution_text")
  unitText        String         @default("") @map("unit_text")
  programText     String         @default("") @map("program_text")
  academicLevel   AcademicLevel? @map("academic_level")
  yearLabel       String?        @map("year_label")
  position        String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  school      OrgUnit?     @relation("ProfileSchool", fields: [schoolId], references: [id], onDelete: SetNull)
  department  OrgUnit?     @relation("ProfileDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  office      OrgUnit?     @relation("ProfileOffice", fields: [officeId], references: [id], onDelete: SetNull)
  program     OrgUnit?     @relation("ProfileProgram", fields: [programId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@map("person_profiles")
}

/// An imported registrar or HR row, matched by verified email on account creation.
model DirectoryEntry {
  id              String         @id @default(uuid())
  email           String         @unique
  studentNumber   String?        @map("student_number")
  kind            String
  institutionId   String?        @map("institution_id")
  schoolId        String?        @map("school_id")
  departmentId    String?        @map("department_id")
  officeId        String?        @map("office_id")
  programId       String?        @map("program_id")
  institutionText String         @default("") @map("institution_text")
  unitText        String         @default("") @map("unit_text")
  programText     String         @default("") @map("program_text")
  academicLevel   AcademicLevel? @map("academic_level")
  yearLabel       String?        @map("year_label")
  position        String?
  linkedUserId    String?        @unique @map("linked_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  school      OrgUnit?     @relation("DirectorySchool", fields: [schoolId], references: [id], onDelete: SetNull)
  department  OrgUnit?     @relation("DirectoryDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  office      OrgUnit?     @relation("DirectoryOffice", fields: [officeId], references: [id], onDelete: SetNull)
  program     OrgUnit?     @relation("DirectoryProgram", fields: [programId], references: [id], onDelete: SetNull)
  linkedUser  User?        @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@map("directory_entries")
}

/// A conflict of interest one person declared on one protocol. Assignee chains skip them.
model ConflictDeclaration {
  id         String   @id @default(uuid())
  protocolId String   @map("protocol_id")
  userId     String   @map("user_id")
  reason     String
  stepKey    String?  @map("step_key")
  declaredAt DateTime @default(now()) @map("declared_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([protocolId, userId])
  @@map("conflict_declarations")
}

/// A value for a setting that starts on a later date.
model SettingSchedule {
  id            String    @id @default(uuid())
  key           String
  value         Json
  effectiveFrom DateTime  @map("effective_from")
  appliedAt     DateTime? @map("applied_at")
  cancelledAt   DateTime? @map("cancelled_at")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([key, effectiveFrom])
  @@map("setting_schedules")
}

/// Protocol code sequence, one row per year.
model CodeCounter {
  year      Int      @id
  last      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("code_counters")
}

enum FeeBasis {
  EXPEDITED
  FULL
  EXEMPT
}

enum BillStatus {
  ISSUED
  PAID_PENDING
  PARTIALLY_PAID
  VERIFIED
  REJECTED
  WAIVED
}

model ClientType {
  key       String   @id
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("client_types")
}

/// Dated fee amounts. The schedule in effect on the issue date prices a bill.
model FeeSchedule {
  id            String   @id @default(uuid())
  effectiveFrom DateTime @map("effective_from") @db.Date
  approvedRef   String   @default("") @map("approved_ref")
  notes         String   @default("")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  rates FeeRate[]
  rules FeeRule[]
  bills Bill[]

  @@index([effectiveFrom])
  @@map("fee_schedules")
}

/// Amount in centavos for one client type and basis.
model FeeRate {
  id            String   @id @default(uuid())
  scheduleId    String   @map("schedule_id")
  clientTypeKey String   @map("client_type_key")
  basis         FeeBasis
  amount        Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  schedule FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, clientTypeKey, basis])
  @@map("fee_rates")
}

/// A percent of the base rate, such as the 3rd-to-Nth review.
model FeeRule {
  id         String   @id @default(uuid())
  scheduleId String   @map("schedule_id")
  key        String
  label      String   @default("")
  percent    Int
  fromRound  Int?     @map("from_round")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  schedule FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, key])
  @@map("fee_rules")
}

/// One statement of account. Amounts are centavos.
model Bill {
  id              String     @id @default(uuid())
  protocolId      String     @map("protocol_id")
  versionId       String     @map("version_id")
  round           Int        @default(1)
  description     String
  amount          Int
  amountPaid      Int        @default(0) @map("amount_paid")
  scheduleId      String?    @map("schedule_id")
  clientTypeKey   String?    @map("client_type_key")
  basis           String     @default("")
  status          BillStatus @default(ISSUED)
  reason          String?
  issuedById      String?    @map("issued_by_id")
  issuedAt        DateTime   @default(now()) @map("issued_at")
  verifiedById    String?    @map("verified_by_id")
  verifiedAt      DateTime?  @map("verified_at")
  statementFileId String?    @map("statement_file_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  protocol Protocol     @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  schedule FeeSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([protocolId, round])
  @@index([status])
  @@index([issuedAt])
  @@map("bills")
}
